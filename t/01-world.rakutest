use Test;

plan 15;

use Yononaka::World;

my $world = Yononaka::World.new(
  min-x => -5, 
  min-y => -5, 
  max-x => 5, 
  max-y => 5,
  :wraps-x,
  :!wraps-y
);

is $world.span-x, 11, 'World is 11 plots across';
is $world.span-y, 11, 'World is 11 plots tall';

is-deeply $world.normalize( 3, 3 ), ( 3, 3 ), 'a point in the world remains unchanged';
is-deeply $world.normalize( 5, -5 ), ( 5, -5 ), 'an edge point comes back correctly';
is-deeply $world.normalize( 6, 1 ), ( -5, 1 ), 'stepping off east edge wraps to west edge';
is-deeply $world.normalize( -6, 1 ), ( 5, 1 ), 'stepping off west edge wraps to east edge';
is-deeply $world.normalize( 17, 1 ), ( -5, 1 ), 'leaping a whole positive worlds width wraps correctly';
is-deeply $world.normalize( -17, 1 ), ( 5, 1 ), 'leaping a whole negative worlds width wraps correctly';
nok $world.normalize( 1, 6 ).defined, 'cannot step off unwrapped edge of world';

$world = Yononaka::World.new(
  min-x => 0,
  min-y => 0,
  max-x => 5,
  max-y => 5,
  :!wraps-x,
  :wraps-y
);

is $world.span-x, 6, 'Corner world is 6 plots across';
is $world.span-y, 6, 'Corner world is 6 plots tall';

is-deeply $world.normalize( 1, -1 ), ( 1, 5 ), 'stepping off bottom edge wraps to top in corner world';
is-deeply $world.normalize( 1, 6 ), ( 1, 0 ), 'stepping off top edge wraps to bottom in corner world';

dies-ok { Yononaka::World.new(
  min-x => 5,
  min-y => -5,
  max-x => -5,
  max-y => 5,
  :wraps-x,
  :wraps-y
) }, 'world with min-x greater than max-x refuses to instantiate';

dies-ok { Yononaka::World.new(
  min-x => -5,
  min-y => 5,
  max-x => 5,
  max-y => -5,
  :wraps-x,
  :wraps-y
) }, 'world with min-y greater than max-y refuses to instantiate'; 

